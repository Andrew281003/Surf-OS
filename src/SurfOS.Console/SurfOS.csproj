<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SurfOS</AssemblyName>
    <RootNamespace>SurfOS</RootNamespace>
    <!-- Icon file for the application. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyTitle>SurfOS</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SurfOS.Core\**\*.cs" />
    <Compile Include="..\SurfOS.Domain\**\*.cs" />
    <Compile Include="..\SurfOS.Features\**\*.cs" />
    <Compile Include="..\SurfOS.Infrastructure\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
    <None Include="..\..\scripts\Launch-SurfOS.cmd" Link="Launch-SurfOS.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Firestore" Version="4.2.0" />
    <PackageReference Include="System.Windows.Extensions" Version="9.0.0" />
  </ItemGroup>

  <Target Name="RemoveStaleBundledCredentials" BeforeTargets="Build;Publish;Clean">
    <ItemGroup>
      <StaleBundledCredential Include="$(BaseOutputPath)**\secrets.json" />
    </ItemGroup>
    <Delete Files="@(StaleBundledCredential)" />
  </Target>

</Project>
