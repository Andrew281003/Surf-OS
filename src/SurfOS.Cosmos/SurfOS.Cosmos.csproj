    <AssemblyName>SurfOS</AssemblyName>
    <RootNamespace>SurfOS</RootNamespace>
    <CosmosKernelClass>SurfOS.Kernel</CosmosKernelClass>
  </PropertyGroup>

  <ItemGroup>
