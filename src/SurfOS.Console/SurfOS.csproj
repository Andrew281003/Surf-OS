<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SurfOS</AssemblyName>
    <RootNamespace>SurfOS</RootNamespace>
    <AssemblyTitle>SurfOS</AssemblyTitle>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/secrets.json;**/*.pem;**/*.p12;**/*.pfx;**/*service-account*.json</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SurfOS.Core\**\*.cs" />
    <Compile Include="..\SurfOS.Domain\**\*.cs" />
    <Compile Include="..\SurfOS.Features\**\*.cs" />
    <Compile Include="..\SurfOS.Infrastructure\**\*.cs" />
    <Compile Update="..\SurfOS.Features\Installer\Menus\BIOS.cs">
      <Link>Installer\Menus\BIOS.cs</Link>
    </Compile>
    <Compile Update="..\SurfOS.Features\Installer\Menus\Boot_Manager.cs">
      <Link>Installer\Menus\Boot_Manager.cs</Link>
    </Compile>
    <Compile Update="..\SurfOS.Domain\Filesystem\VirtualFileSystem.cs">
      <Link>Music\Filesystem\VirtualFileSystem.cs</Link>
    </Compile>
    <Compile Update="..\SurfOS.Domain\Filesystem\VirtualFileSystem.cs">
      <Link>Packages\Filesystem\VirtualFileSystem.cs</Link>
    </Compile>
    <Compile Update="..\SurfOS.Domain\Filesystem\VirtualFileSystem.cs">
      <Link>Rendering\Filesystem\VirtualFileSystem.cs</Link>
    </Compile>
    <Compile Update="..\SurfOS.Domain\Filesystem\VirtualFileSystem.cs">
      <Link>SurfAI\Filesystem\VirtualFileSystem.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
    <EmbeddedResource Include="Trust/catalog-public-prod-*.pub" LogicalName="SurfOS.Trust.%(Filename)%(Extension)" />
    <None Include="..\..\scripts\Launch-SurfOS.cmd" Link="Launch-SurfOS.cmd"
          Condition="!$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="System.Windows.Extensions" Version="9.0.0" />
  </ItemGroup>

  <Target Name="RejectBundledCredentials" BeforeTargets="Build;Publish">
    <ItemGroup>
      <BundledCredential Include="$(BaseOutputPath)**/secrets.json;$(BaseOutputPath)**/*.pem;$(BaseOutputPath)**/*.p12;$(BaseOutputPath)**/*.pfx" />
      <BundledCredential Include="$(PublishDir)/**/secrets.json;$(PublishDir)/**/*.pem;$(PublishDir)/**/*.p12;$(PublishDir)/**/*.pfx" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Message Importance="High" Condition="'@(BundledCredential)' != ''" Text="Credential-like artifact path: @(BundledCredential)" />
    <Error Condition="'@(BundledCredential)' != ''" Text="Credential-like file found in build or publish output. Remove it manually before building." />
  </Target>

</Project>
